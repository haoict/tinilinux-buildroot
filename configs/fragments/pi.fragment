BR2_ARM_FPU_VFPV4=y
BR2_TARGET_GENERIC_HOSTNAME="pi"
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,f6ac5152db4a19dd36e9b5a50fe27f95f58d3d4f)/linux-rpi-7.0.5.tar.gz"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_TiniLinux_PATH)/board/pi3b/linux/linux.conf"
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2710-rpi-3-b broadcom/bcm2710-rpi-3-b-plus broadcom/bcm2710-rpi-cm3"
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_BT=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI_X=y
BR2_PACKAGE_RASPI_GPIO=y
BR2_PACKAGE_RTL8188EU=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_PI_ST7789V_240X240_DTBO=y
BR2_PACKAGE_PI_UTILS=y
BR2_PACKAGE_ROCKNIX_JOYPAD=n
BR2_PACKAGE_GPTOKEYB2=n
BR2_PACKAGE_INSTALL_NOTHING=y
BR2_PACKAGE_FBGIF=y
BR2_PACKAGE_FBDOOM=y